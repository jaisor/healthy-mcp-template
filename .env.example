# Settings for the Docker setup (docs/docker.md). Copy this file to .env, which is gitignored, and fill it in.
# Never commit .env: it holds your secrets.

# The address people and Claude reach, with no path. The connector URL is this followed by /mcp.
# On a server: your https address (the "https" compose profile serves it). To try it on your own machine: http://localhost:8788
PUBLIC_URL=https://health.example.com

# GitHub OAuth App (README step 3), with the callback PUBLIC_URL/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (README step 4), with the redirect URI PUBLIC_URL/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string, 32+ characters, unique to this app: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=

# USDA food database key (README step 5)
USDA_API_KEY=
